<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Awoo.Flyout.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Media">

    <Window.SystemBackdrop>
        <media:DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <!-- Transparent so the acrylic backdrop shows through; every brush below
         is a theme resource, which is what makes light and dark both work. -->
    <Grid Background="Transparent" Padding="16,14,16,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon
                Glyph="&#xE767;"
                FontSize="16"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock
                Text="awoo"
                VerticalAlignment="Center"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </StackPanel>

        <TextBlock
            Grid.Row="1"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            Style="{ThemeResource BodyTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Volume controls land here." />
    </Grid>
</Window>
