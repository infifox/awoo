<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Awoo.Flyout.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:vm="using:Awoo.ViewModels">

    <Window.SystemBackdrop>
        <media:DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <!-- Transparent so the acrylic backdrop shows through; every brush below
         is a theme resource, which is what makes light and dark both work. -->
    <Grid Background="Transparent">
        <Grid.Resources>
            <!-- How far the flyout's content sits from its edges, and the
                 padding inside the foot's button: the same measure, which is
                 what squares the foot up against the rest. -->
            <Thickness x:Key="FlyoutPadding">12</Thickness>

            <!-- The mute buttons take the Windows volume flyout's manners:
                 nothing at rest, a wash under the pointer, and no accent when
                 they are on — a muted row says so with its glyph alone. These
                 are the stock ToggleButton brushes narrowed to this window,
                 where every ToggleButton is a mute button; the colours are the
                 theme's own, which is what keeps light and dark both right. -->
            <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SubtleFillColorTertiary}" />

            <!-- The checked states' foreground is white-on-accent in stock
                 Fluent, and there is no accent here any more. -->
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource TextFillColorSecondary}" />

            <!-- The switcher's two items, re-templated. The stock
                 SelectorBarItem lays its label out in an Auto-width column
                 and gives its root no background, so an item handed half the
                 bar keeps the label at the left of that half and the rest of
                 the half is neither centred under the label nor clickable.
                 A star column and a background of its own fix both; the
                 parts, the state names and the pill under the label are
                 WinUI's own, so the switcher still reads as a SelectorBar.

                 The stock 10 of top padding goes with it: the flyout's own
                 12 is what the gap above the labels should read as, and the
                 two of them stacked are what made the top of the flyout sit
                 looser than its left. -->
            <Style x:Key="FlyoutTabItemStyle" TargetType="SelectorBarItem">
                <!-- Not the stock null: a null background is not hit-tested,
                     which is what kept the click target down to the label.
                     Transparent and nothing else, though: the states below
                     answer the pointer by recolouring the label and leave the
                     background where it is, which is how this switcher has
                     always read. -->
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource SelectorBarItemForeground}" />
                <Setter Property="Padding" Value="12,0,12,7" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualMargin" Value="{ThemeResource SelectorBarItemFocusVisualMargin}" />
                <!-- The property's own default is false, so without this the
                     keyboard's focus rectangle is never drawn at all. -->
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="SelectorBarItem">
                            <Grid
                                x:Name="PART_ContainerRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                RowDefinitions="Auto,Auto"
                                ColumnDefinitions="Auto,*">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CombinedStates">
                                        <VisualState x:Name="UnselectedNormal" />

                                        <VisualState x:Name="UnselectedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundPointerOver}" />
                                                <Setter Target="PART_IconVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundPointerOver}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="UnselectedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundPressed}" />
                                                <Setter Target="PART_IconVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundPressed}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="SelectedNormal">
                                            <!-- The same brush as at rest in light and dark, but the
                                                 system highlight colour in high contrast — where it is
                                                 what says which tab is selected. -->
                                            <VisualState.Setters>
                                                <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundSelected}" />
                                                <Setter Target="PART_IconVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundSelected}" />
                                            </VisualState.Setters>
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PillTransform" Storyboard.TargetProperty="ScaleX">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.167" Value="4" KeySpline="0,0,0,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_SelectionVisual" Storyboard.TargetProperty="Opacity">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.167" Value="1" KeySpline="0,0,0,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>

                                        <VisualState x:Name="SelectedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundPointerOver}" />
                                                <Setter Target="PART_IconVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundPointerOver}" />
                                            </VisualState.Setters>
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PillTransform" Storyboard.TargetProperty="ScaleX">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.167" Value="4" KeySpline="0,0,0,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_SelectionVisual" Storyboard.TargetProperty="Opacity">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.167" Value="1" KeySpline="0,0,0,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>

                                        <VisualState x:Name="SelectedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundPressed}" />
                                                <Setter Target="PART_IconVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundPressed}" />
                                            </VisualState.Setters>
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PillTransform" Storyboard.TargetProperty="ScaleX">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.167" Value="4" KeySpline="0,0,0,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_SelectionVisual" Storyboard.TargetProperty="Opacity">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.167" Value="1" KeySpline="0,0,0,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>

                                    <VisualStateGroup x:Name="DisabledStates">
                                        <VisualState x:Name="Enabled" />

                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundDisabled}" />
                                                <Setter Target="PART_IconVisual.Foreground" Value="{ThemeResource SelectorBarItemForegroundDisabled}" />
                                                <Setter Target="PART_SelectionVisual.Fill" Value="{ThemeResource SelectorBarItemDisabledPillFill}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <!-- In the star column, so the slack of the
                                     item's half is the label's to be centred
                                     in rather than space left over at the
                                     right of an Auto column. -->
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Margin="{TemplateBinding Padding}"
                                    Spacing="8"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <ContentPresenter
                                        x:Name="PART_IconVisual"
                                        Content="{TemplateBinding Icon}"
                                        Margin="-2,0"
                                        Foreground="{TemplateBinding Foreground}"
                                        RenderTransformOrigin="0.5,0.5">
                                        <ContentPresenter.RenderTransform>
                                            <ScaleTransform x:Name="IconTransform" ScaleX="0.8" ScaleY="0.8" />
                                        </ContentPresenter.RenderTransform>
                                    </ContentPresenter>

                                    <TextBlock
                                        x:Name="PART_TextVisual"
                                        Text="{TemplateBinding Text}"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        FontSize="{TemplateBinding FontSize}"
                                        Foreground="{TemplateBinding Foreground}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- WinUI's own pill, at the width it draws
                                     itself: a short mark centred under the
                                     label, the way Windows' settings
                                     underlines the page you are on, rather
                                     than a rule across the whole half. -->
                                <Rectangle
                                    x:Name="PART_SelectionVisual"
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Width="4"
                                    Height="3"
                                    RadiusX="0.5"
                                    RadiusY="1"
                                    Fill="{ThemeResource SelectorBarItemPillFill}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    RenderTransformOrigin="0.5,0.5"
                                    IsHitTestVisible="False"
                                    Opacity="0">
                                    <Rectangle.RenderTransform>
                                        <CompositeTransform x:Name="PillTransform" ScaleX="1" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>

                                <Rectangle
                                    x:Name="PART_CommonVisual"
                                    Grid.RowSpan="2"
                                    Grid.ColumnSpan="2"
                                    Fill="{ThemeResource SelectorBarItemBackground}"
                                    Stroke="{ThemeResource SelectorBarItemBorderBrush}"
                                    StrokeThickness="1"
                                    IsHitTestVisible="False" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- One spatial sound format a device could be put into. The
                 same shape as a device row's default marker and an app row's
                 route, because it is the same question again: which of
                 these. -->
            <DataTemplate x:Key="SpatialOptionTemplate" x:DataType="vm:SpatialOptionViewModel">
                <RadioButton
                    GroupName="{x:Bind GroupName}"
                    MinWidth="0"
                    Margin="8,0,0,0"
                    Padding="8,0,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                    Checked="{x:Bind Choose}"
                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        MaxLines="1" />
                </RadioButton>
            </DataTemplate>

            <!-- One device: the default marker and its name on top, with its
                 spatial sound beside them, and its volume underneath. Shared
                 by the outputs and the inputs, which the Plasma applet treats
                 alike — only an output that has spatial sound carries the
                 selector. -->
            <DataTemplate x:Key="DeviceRowTemplate" x:DataType="vm:DeviceRowViewModel">
                <Grid RowSpacing="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- A radio button is the Fluent answer to Plasma's
                             default-device marker: it shows which device is the
                             default and sets it in the one click. -->
                        <RadioButton
                            GroupName="{x:Bind GroupName}"
                            MinWidth="0"
                            Margin="8,0,0,0"
                            Padding="8,0,0,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            IsEnabled="{x:Bind CanSetDefault}"
                            IsChecked="{x:Bind IsDefault, Mode=OneWay}"
                            Checked="{x:Bind MakeDefault}"
                            ToolTipService.ToolTip="{x:Bind DefaultToolTip, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                            <!-- The name alone: which kind of device this is, the
                                 Outputs and Inputs headings already say. -->
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Bind Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                MaxLines="1" />
                        </RadioButton>

                        <!-- What spatial sound this device is in. Hidden
                             outright on an input, and on an output with no
                             format to offer, rather than showing a control
                             that could do nothing. The format's name shows
                             only when there is one; off is the quiet, common
                             case, and the glyph alone says what the button
                             is about. -->
                        <DropDownButton
                            Grid.Column="1"
                            Height="28"
                            MaxWidth="150"
                            Padding="8,0,6,0"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind CanSetSpatial, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind SpatialToolTip, Mode=OneWay}"
                            AutomationProperties.Name="Spatial sound">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="{x:Bind SpatialGlyph}" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind SpatialName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    MaxLines="1"
                                    Visibility="{x:Bind HasSpatial, Mode=OneWay}" />
                            </Grid>

                            <DropDownButton.Flyout>
                                <!-- Constrained to the flyout window, for the
                                     reason the app rows' selector gives: a
                                     windowed popup would take the foreground
                                     and the flyout dismisses when it loses
                                     it. -->
                                <Flyout Placement="Bottom" ShouldConstrainToRootBounds="True">
                                    <StackPanel MinWidth="200" Spacing="4">
                                        <TextBlock
                                            Text="Spatial sound"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        <ScrollViewer
                                            MaxHeight="260"
                                            HorizontalScrollMode="Disabled"
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                            <ItemsRepeater
                                                ItemsSource="{x:Bind SpatialOptions, Mode=OneWay}"
                                                ItemTemplate="{StaticResource SpatialOptionTemplate}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="2" />
                                                </ItemsRepeater.Layout>
                                            </ItemsRepeater>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <!-- Indented like the radio button above it, so the mute
                         button's edge lines up with the radio rather than
                         with the name, the way the Windows volume flyout
                         stacks them. -->
                    <Grid Grid.Row="1" Margin="8,0,0,0" ColumnSpacing="10" Height="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ToggleButton
                            Width="36"
                            Height="32"
                            Padding="0"
                            BorderThickness="0"
                            IsChecked="{x:Bind IsMuted, Mode=TwoWay}"
                            ToolTipService.ToolTip="{x:Bind MuteToolTip, Mode=OneWay}"
                            AutomationProperties.Name="Mute">
                            <FontIcon FontSize="16" Glyph="{x:Bind MuteGlyph, Mode=OneWay}" />
                        </ToggleButton>

                        <Slider
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Minimum="0"
                            Maximum="100"
                            StepFrequency="1"
                            SmallChange="1"
                            LargeChange="5"
                            IsThumbToolTipEnabled="False"
                            Value="{x:Bind Percent, Mode=TwoWay}"
                            AutomationProperties.Name="Volume" />

                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            MinWidth="40"
                            TextAlignment="Right"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind PercentText, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </DataTemplate>

            <!-- One device an application's sound could be sent to. The same
                 shape as a device row's default marker, because it is the
                 same question one level down: which device, of these. -->
            <DataTemplate x:Key="RouteOptionTemplate" x:DataType="vm:RouteOptionViewModel">
                <RadioButton
                    GroupName="{x:Bind GroupName}"
                    MinWidth="0"
                    Margin="8,0,0,0"
                    Padding="8,0,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                    Checked="{x:Bind Choose}"
                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        MaxLines="1" />
                </RadioButton>
            </DataTemplate>

            <!-- One application: its icon, name and output device on top, its
                 own volume underneath. Shared by what is playing and what is
                 recording, which the Plasma applet treats alike — only a
                 playing row carries the device selector. -->
            <DataTemplate x:Key="AppRowTemplate" x:DataType="vm:AppRowViewModel">
                <Grid RowSpacing="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Padding="8,0,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- The app's own icon where there is one, and the
                             glyph for what it is doing where there is not. -->
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Image
                                Source="{x:Bind Icon, Mode=OneWay}"
                                Visibility="{x:Bind HasIcon, Mode=OneWay}" />

                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="{x:Bind FallbackGlyph}"
                                Visibility="{x:Bind HasNoIcon, Mode=OneWay}" />
                        </Grid>

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{x:Bind Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            MaxLines="1" />

                        <!-- Where this application's sound goes. Hidden
                             outright where Windows would not give up the
                             routing interface, rather than offering a
                             control that would silently do nothing. The
                             device's name shows only when the application
                             has been sent somewhere of its own; following
                             the default is the quiet, common case. -->
                        <DropDownButton
                            Grid.Column="2"
                            Height="28"
                            MaxWidth="150"
                            Padding="8,0,6,0"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind CanRoute, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind RouteToolTip, Mode=OneWay}"
                            AutomationProperties.Name="Output device">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="{x:Bind RouteGlyph}" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind RouteName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    MaxLines="1"
                                    Visibility="{x:Bind HasRoute, Mode=OneWay}" />
                            </Grid>

                            <DropDownButton.Flyout>
                                <!-- Constrained to the flyout window, which
                                     is what keeps it a popup inside our own
                                     XAML root: a windowed popup would take
                                     the foreground and the flyout dismisses
                                     when it loses it. -->
                                <Flyout Placement="Bottom" ShouldConstrainToRootBounds="True">
                                    <StackPanel MinWidth="200" Spacing="4">
                                        <TextBlock
                                            Text="Play on"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        <ScrollViewer
                                            MaxHeight="260"
                                            HorizontalScrollMode="Disabled"
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                            <ItemsRepeater
                                                ItemsSource="{x:Bind RouteOptions, Mode=OneWay}"
                                                ItemTemplate="{StaticResource RouteOptionTemplate}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="2" />
                                                </ItemsRepeater.Layout>
                                            </ItemsRepeater>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <!-- Lined up with the icon above it, the way a device
                         row's controls line up with its radio button. -->
                    <Grid Grid.Row="1" Margin="8,0,0,0" ColumnSpacing="10" Height="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ToggleButton
                            Width="36"
                            Height="32"
                            Padding="0"
                            BorderThickness="0"
                            IsChecked="{x:Bind IsMuted, Mode=TwoWay}"
                            ToolTipService.ToolTip="{x:Bind MuteToolTip, Mode=OneWay}"
                            AutomationProperties.Name="Mute">
                            <FontIcon FontSize="16" Glyph="{x:Bind MuteGlyph, Mode=OneWay}" />
                        </ToggleButton>

                        <Slider
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Minimum="0"
                            Maximum="100"
                            StepFrequency="1"
                            SmallChange="1"
                            LargeChange="5"
                            IsThumbToolTipEnabled="False"
                            Value="{x:Bind Percent, Mode=TwoWay}"
                            AutomationProperties.Name="Volume" />

                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            MinWidth="40"
                            TextAlignment="Right"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind PercentText, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Everything above the foot, inside the flyout's own padding: the
             switcher, and whichever of the two lists it has selected. -->
        <Grid Padding="{StaticResource FlyoutPadding}" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Stretched across the flyout, with its two items given half
                 of it each in OnTabsSizeChanged: SelectorBar stacks its
                 items at the width their text wants, so equal halves are
                 not something the markup can ask for.

                 Padding without the stock 4 on top, for the same reason the
                 items lose theirs: the gap above the labels is the flyout's
                 own padding and nothing else. The 4 below it stays, as the
                 room the selection pill sits in. -->
            <SelectorBar
                x:Name="Tabs"
                HorizontalAlignment="Stretch"
                Padding="0,0,0,4"
                SizeChanged="OnTabsSizeChanged"
                SelectionChanged="OnTabChanged">
                <SelectorBarItem
                    x:Name="DevicesTabItem"
                    Text="Devices"
                    Style="{StaticResource FlyoutTabItemStyle}"
                    IsSelected="True" />
                <SelectorBarItem
                    x:Name="ApplicationsTabItem"
                    Text="Applications"
                    Style="{StaticResource FlyoutTabItemStyle}" />
            </SelectorBar>

            <Grid Grid.Row="1">
                <!-- SizeChanged is where the scrollbar's gutter is opened and
                     closed; see OnTabSizeChanged. -->
                <ScrollViewer
                    x:Name="DevicesTab"
                    MaxHeight="420"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    SizeChanged="OnTabSizeChanged">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="Outputs"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind Devices.HasOutputs, Mode=OneWay}" />

                        <ItemsRepeater ItemsSource="{x:Bind Devices.Outputs, Mode=OneWay}"
                                       ItemTemplate="{StaticResource DeviceRowTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="10" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>

                        <TextBlock
                            Text="Inputs"
                            Margin="0,6,0,0"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind Devices.HasInputs, Mode=OneWay}" />

                        <ItemsRepeater ItemsSource="{x:Bind Devices.Inputs, Mode=OneWay}"
                                       ItemTemplate="{StaticResource DeviceRowTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="10" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>

                        <TextBlock
                            Text="No audio devices"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind Devices.IsEmpty, Mode=OneWay}" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="ApplicationsTab"
                    Visibility="Collapsed"
                    MaxHeight="420"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    SizeChanged="OnTabSizeChanged">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="Playing"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind Apps.HasPlayback, Mode=OneWay}" />

                        <ItemsRepeater ItemsSource="{x:Bind Apps.Playback, Mode=OneWay}"
                                       ItemTemplate="{StaticResource AppRowTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="10" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>

                        <TextBlock
                            Text="Recording"
                            Margin="0,6,0,0"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind Apps.HasRecording, Mode=OneWay}" />

                        <ItemsRepeater ItemsSource="{x:Bind Apps.Recording, Mode=OneWay}"
                                       ItemTemplate="{StaticResource AppRowTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="10" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>

                        <!-- Centred and understated: nothing playing is the
                             quiet case rather than something to announce. -->
                        <TextBlock
                            Text="No applications are playing or recording audio"
                            Margin="0,4,0,4"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind Apps.IsEmpty, Mode=OneWay}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- The tabs above, the way out below. Edge to edge of the flyout,
             running through its padding rather than stopping at it, the way
             the Windows volume flyout's divider does. -->
        <Border
            Grid.Row="1"
            Height="1"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- The Plasma applet's "Configure Audio Devices…", under the name
             Windows' own volume flyout gives the same link. Borderless and
             full width so it reads as the foot of the flyout rather than as a
             button somebody put there; the hover and pressed states come from
             the Button template, which overrides this background. Square
             corners, because the foot reaches the flyout's own edges and it is
             the window's rounded frame that clips them. -->
        <Button
            x:Name="SoundSettingsButton"
            Grid.Row="2"
            Padding="{StaticResource FlyoutPadding}"
            CornerRadius="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Background="Transparent"
            BorderThickness="0"
            Click="OnSoundSettingsClick"
            AutomationProperties.Name="More sound settings">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    FontSize="14"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE713;" />

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="Sound settings" />
            </Grid>
        </Button>
    </Grid>
</Window>
