<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Awoo.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:vm="using:Awoo.ViewModels">

    <Window.SystemBackdrop>
        <media:MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- One page: the two settings awoo has, and the devices it will show.
         Everything else awoo could offer is either Windows' own setting or a
         decision the brief settled. -->
    <Grid Background="Transparent" Padding="24,20,24,24" RowSpacing="18">
        <Grid.Resources>
            <!-- One device: its name, and whether the volume control lists
                 it. Shared by the outputs and the inputs, which are hidden
                 the same way. -->
            <DataTemplate x:Key="DeviceVisibilityTemplate" x:DataType="vm:DeviceVisibilityViewModel">
                <Grid ColumnSpacing="12" MinHeight="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        MaxLines="1" />

                    <!-- No On/Off beside it: a column of them would only say
                         what the switch's own position says, and the
                         switches line up with the two above instead. -->
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        OnContent=""
                        OffContent=""
                        IsOn="{x:Bind IsVisible, Mode=TwoWay}"
                        ToolTipService.ToolTip="{x:Bind VisibilityToolTip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    Text="Volume step"
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />

                <TextBlock
                    Text="When moving the scroll wheel over the tray icon, the volume is adjusted. This sets how many steps the volume changes for each notch moved on the scroll wheel."
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <controls:NumberBox
                x:Name="VolumeStepBox"
                Grid.Column="1"
                Width="120"
                VerticalAlignment="Center"
                Minimum="1"
                Maximum="25"
                SmallChange="1"
                LargeChange="5"
                SpinButtonPlacementMode="Compact"
                Value="{x:Bind ViewModel.VolumeStep, Mode=TwoWay}"
                AutomationProperties.Name="Volume step" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    Text="Start with Windows"
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />

                <TextBlock
                    Text="Runs Awoo when you sign in."
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ToggleSwitch
                x:Name="AutostartSwitch"
                Grid.Column="1"
                VerticalAlignment="Center"
                MinWidth="0"
                IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                AutomationProperties.Name="Start with Windows" />
        </Grid>

        <!-- Which devices the volume control lists. Everything plugged in is
             here: a device that is away cannot be pointed at, and it keeps
             whatever it was set to for when it comes back. -->
        <StackPanel Grid.Row="2" Spacing="8">
            <StackPanel Spacing="2">
                <TextBlock
                    Text="Shown devices"
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />

                <TextBlock
                    Text="Turn devices off here to hide them from the volume control."
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- SizeChanged is where the scrollbar's gutter is opened and
                 closed; see OnDeviceListSizeChanged. -->
            <ScrollViewer
                x:Name="DeviceList"
                MaxHeight="240"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                SizeChanged="OnDeviceListSizeChanged">
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="Outputs"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind ViewModel.HasOutputs, Mode=OneWay}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Outputs, Mode=OneWay}"
                                   ItemTemplate="{StaticResource DeviceVisibilityTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="2" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>

                    <TextBlock
                        Text="Inputs"
                        Margin="0,6,0,0"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind ViewModel.HasInputs, Mode=OneWay}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Inputs, Mode=OneWay}"
                                   ItemTemplate="{StaticResource DeviceVisibilityTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="2" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>

                    <TextBlock
                        Text="No audio devices"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Window>
