<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Awoo.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:media="using:Microsoft.UI.Xaml.Media">

    <Window.SystemBackdrop>
        <media:MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- One page, two settings. Everything else awoo could offer is either
         Windows' own setting or a decision the brief settled. -->
    <Grid Background="Transparent" Padding="24,20,24,24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    Text="Volume step"
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />

                <TextBlock
                    Text="How far one notch of the scroll wheel over the tray icon moves the volume."
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <controls:NumberBox
                x:Name="VolumeStepBox"
                Grid.Column="1"
                Width="120"
                VerticalAlignment="Center"
                Minimum="1"
                Maximum="25"
                SmallChange="1"
                LargeChange="5"
                SpinButtonPlacementMode="Compact"
                Value="{x:Bind ViewModel.VolumeStep, Mode=TwoWay}"
                AutomationProperties.Name="Volume step" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    Text="Start with Windows"
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />

                <TextBlock
                    Text="Runs awoo when you sign in. The same entry as the one in Task Manager's Startup tab."
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ToggleSwitch
                x:Name="AutostartSwitch"
                Grid.Column="1"
                VerticalAlignment="Center"
                MinWidth="0"
                IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                AutomationProperties.Name="Start with Windows" />
        </Grid>
    </Grid>
</Window>
